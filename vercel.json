{
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/_blob/:id", "destination": "/api/blob?id=:id" }
  ],
  "functions": {
    "api/ai.js": { "maxDuration": 300 },
    "api/gmail.js": { "maxDuration": 60 }
  },
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] },
    { "source": "/(index.html)?", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
    { "source": "/runtime.js", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] }
  ]
}
